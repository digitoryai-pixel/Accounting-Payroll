# Application
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=digitory_financial
DB_USER=digitory
DB_PASSWORD=changeme
DB_POOL_MIN=2
DB_POOL_MAX=20

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRY=24h
JWT_REFRESH_EXPIRY=7d

# AWS S3 (for payslip PDFs, reports)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_PAYSLIPS=digitory-payslips
S3_BUCKET_REPORTS=digitory-reports

# Digitory API Integration
DIGITORY_API_BASE_URL=https://api.digitory.com/v1
DIGITORY_API_KEY=
DIGITORY_WEBHOOK_SECRET=

# Email (for payslip distribution)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=payroll@digitory.com

# Encryption
ENCRYPTION_KEY=32-char-encryption-key-change-me
SALARY_ENCRYPTION_KEY=32-char-salary-key-change-in-prod
